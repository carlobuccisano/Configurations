{
   	"keyboard/state": {
       	"numlock": true,
       	"capslock": true,
       	"format": "{name} {icon}",
       	"format-icons": {
           	"locked": "",
           	"unlocked": ""
       	}
   	},
	"sway/language": {
   		"format": "{flag} {variant}",
   		"on-click": "swaymsg input type:keyboard xkb_switch_layout next"
	}
}
